**/__pycache__/

# Run databases. The real one lives in ~/.local/share/vacuum-lab/, but a
# --db path pointed inside the repo is the obvious thing to do while testing.
*.db
*.db-wal
*.db-shm

# Vendor installers and Pfeiffer's own Windows software. Half a gigabyte of
# binaries that git can only store as opaque blobs; they stay on disk, not in
# the repository.
installer/
pfeiffer_software/
